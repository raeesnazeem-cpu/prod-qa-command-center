# Copy to infra/aws/secrets.env (never commit it) and fill in, then run
# infra/aws/02-make-secrets.sh. Ask the project owner for each value.
# One KEY=value per line, no quotes needed. Leave a line empty if not used.

# --- Must be the SAME as today's QACC production (TED is set up with them) ---
TED_SSO_SECRET=
TED_WEBHOOK_SECRET=
TED_API_TOKEN=
X_API_KEY=
# Decrypts data already stored in the database. Must match the old server.
ENCRYPTION_SECRET=

# --- Third-party keys (copy from the old server's environment) ---------------
GOOGLE_AI_API_KEY=
GEMINI_API_KEY=
GEMINI_KEYS=
GROQ_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=
COHERE_API_KEY=
CEREBRAS_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
SCRAPER_API_KEY=
PAGESPEED_API_KEY=
GOOGLE_PAGESPEED_API_KEY=
GOOGLE_PLACES_API_KEY=
HUBSPOT_TOKEN=
# GitHub token with READ access to client repos
GIT_FIX_TOKEN=

# Everything else (database password, JWT secret, service key, session secret,
# recording token) is generated by the script. Do not add them here.

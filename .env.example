# Frontend
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_CLERK_PUBLISHABLE_KEY=
VITE_API_URL=
VITE_SENTRY_DSN=
# TED's frontend base URL (e.g. http://localhost:4200 in local dev). Powers
# "Continue with TED" on /login.
VITE_TED_BASE_URL=
# Optional client-side-only login gate, independent of TED SSO and of the
# apps/api auth gate below — leave unset to keep it fully off. Note: even when
# set, it cannot authenticate against the API; clerkAuth's gate accepts only a
# qacc_session cookie (TED SSO), so this gate has no server-side counterpart.
VITE_GOOGLE_CLIENT_ID=

# Backend / API
SUPABASE_SERVICE_ROLE_KEY=
CLERK_SECRET_KEY=
GOOGLE_AI_API_KEY=
UPSTASH_REDIS_URL=
UPSTASH_REDIS_TOKEN=
BASECAMP_WEBHOOK_SECRET=
RESEND_API_KEY=
SENTRY_DSN=
ENCRYPTION_SECRET=
FIGMA_ACCESS_TOKEN=

# --- Auth gate (login gate only, not RBAC — see middleware/clerkAuth.ts) ---
# OFF by default; flip to "true" to require a valid qacc_session (TED SSO) on
# every request. TED SSO is the sole login authority for this gate — there is
# no bearer-token/Google fallback that could authenticate independently of it.
AUTH_GATE_ENABLED=
# QACC's own public origin — used to build the FRONTEND_URL redirect after a
# TED ticket exchange, and as the CORS-allowed origin for the API.
FRONTEND_URL=

# --- TED SSO ("Continue with TED") ------------------------------------------
# OFF by default; flip to "true" once TED's qacc.sso.secret is configured.
SSO_TED_ENABLED=
# Must equal TED's own QACC_SSO_SECRET exactly. Local-dev-only value — never
# reuse BUILD_TOOL_SSO_SECRET or WEB_AUDIT_SSO_SECRET, and never commit a real
# secret here.
TED_SSO_SECRET=
# QACC's own session-signing secret — QACC-only, never shared with TED or any
# other app. Generate with: openssl rand -base64 32
QACC_SESSION_SECRET=
